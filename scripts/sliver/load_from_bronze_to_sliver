/*
=============================================================
ETL Script: Bronze to Silver - Customer Information
=============================================================
Script Purpose:
    This script cleanses, deduplicates, and standardizes customer 
    master data from 'datawarehouse_bronze.crm_cust_info' and loads 
    the transformed result into 'datawarehouse_silver.crm_cust_info'.

Transformations Applied:
    1. Deduplication: Filters for the most recent record per 'cst_id' 
       using ROW_NUMBER() based on 'cst_create_date'.
    2. Data Hygiene: Removes unwanted zero IDs (WHERE cst_id != 0) and 
       trims leading/trailing whitespace from names.
    3. Standardization: Converts coded strings ('S', 'M', 'F') into 
       readable descriptive attributes ('Single', 'Married', 'Female', 'Male') 
       with a fallback 'n/a' value.
*/

USE datawarehouse_silver;

-- Optional: Truncate target table before load to ensure idempotent executions
TRUNCATE TABLE crm_cust_info;

INSERT INTO crm_cust_info
(
    cst_id,
    cst_key,
    cst_firstname,
    cst_lastname,
    cst_marital_status,
    cst_gndr,
    cst_create_date
)
SELECT
    cst_id,
    cst_key,
    TRIM(cst_firstname) AS cst_firstname,
    TRIM(cst_lastname)  AS cst_lastname,

    CASE
        WHEN UPPER(TRIM(cst_marital_status)) = 'S' THEN 'Single'
        WHEN UPPER(TRIM(cst_marital_status)) = 'M' THEN 'Married'
        ELSE 'n/a'
    END AS cst_marital_status,

    CASE
        WHEN UPPER(TRIM(cst_gndr)) = 'F' THEN 'Female'
        WHEN UPPER(TRIM(cst_gndr)) = 'M' THEN 'Male'
        ELSE 'n/a'
    END AS cst_gndr,

    cst_create_date

FROM
(
    SELECT
        *,
        ROW_NUMBER() OVER (
            PARTITION BY cst_id
            ORDER BY cst_create_date DESC
        ) AS flag_last
    FROM datawarehouse_bronze.crm_cust_info
    WHERE cst_id IS NOT NULL AND cst_id != 0
) t

WHERE flag_last = 1;



/*
=============================================================
ETL Script: Bronze to Silver - Product Information
=============================================================
Script Purpose:
    This script cleanses, extracts keys, standardizes codes, 
    and calculates historic SCD Type 2 end dates for product data 
    from 'datawarehouse_bronze.crm_prd_info' into 'datawarehouse_silver.crm_prd_info'.

Transformations Applied:
    1. Key Parsing: Splits 'prd_key' into 'cat_id' (first 5 chars with hyphens converted to underscores) 
       and a clean product key (from character 7 onward).
    2. Code Mapping: Standardizes product line codes ('M', 'R', 'S', 'T') to full names ('Mountain', 'Road', etc.).
    3. Type 2 History Handling: Dynamically calculates 'prd_end_dt' using LEAD() windowing function 
       minus 1 day to fill missing historical end dates based on the next product record start date.
*/

USE datawarehouse_silver;

-- Optional: Truncate target table before load to ensure idempotent execution
TRUNCATE TABLE crm_prd_info;

INSERT INTO datawarehouse_silver.crm_prd_info
(
    prd_id,
    cat_id,
    prd_key,
    prd_nm,
    prd_cost,
    prd_line,
    prd_start_dt,
    prd_end_dt
)
SELECT
    prd_id,
    REPLACE(SUBSTRING(prd_key, 1, 5), '-', '_') AS cat_id,
    SUBSTRING(prd_key, 7, LENGTH(prd_key)) AS prd_key,
    prd_nm,
    prd_cost,
    CASE 
        WHEN UPPER(TRIM(prd_line)) = 'M' THEN 'Mountain'
        WHEN UPPER(TRIM(prd_line)) = 'R' THEN 'Road'
        WHEN UPPER(TRIM(prd_line)) = 'S' THEN 'Other Sales'
        WHEN UPPER(TRIM(prd_line)) = 'T' THEN 'Touring'
        ELSE 'n/a'
    END AS prd_line,
    CAST(prd_start_dt AS DATE) AS prd_start_dt,
    CAST(
        LEAD(prd_start_dt) OVER (
            PARTITION BY prd_key
            ORDER BY prd_start_dt
        ) - INTERVAL 1 DAY
        AS DATE
    ) AS prd_end_dt
FROM datawarehouse_bronze.crm_prd_info;

-- Verification Query
SELECT * FROM datawarehouse_silver.crm_prd_info;
