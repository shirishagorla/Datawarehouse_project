/*
=============================================================
Data Ingestion Script (MySQL LOAD DATA)
=============================================================
Script Purpose:
    This script loads raw CSV files from local source directories 
    ('source_crm' and 'source_erp') into the Bronze layer tables 
    within the 'datawarehouse_bronze' database.
	
Prerequisites:
    1. Ensure local_infile is enabled:
       SET GLOBAL local_infile = 1;
    2. Ensure table structures are already created in 'datawarehouse_bronze'.
*/

USE datawarehouse_bronze;

-- -----------------------------------------------------------------------------
-- CRM Data Loading
-- -----------------------------------------------------------------------------

-- Load Customer Information
LOAD DATA LOCAL INFILE 'C:/Users/PC/Downloads/source_crm/cust_info.csv'
INTO TABLE crm_cust_info
FIELDS TERMINATED BY ','
ENCLOSED BY '"'
LINES TERMINATED BY '\r\n'
IGNORE 1 ROWS;

-- Load Product Information
LOAD DATA LOCAL INFILE 'C:/Users/PC/Downloads/source_crm/prd_info.csv'
INTO TABLE crm_prd_info
FIELDS TERMINATED BY ','
ENCLOSED BY '"'
LINES TERMINATED BY '\r\n'
IGNORE 1 ROWS;

-- Load Sales Details
LOAD DATA LOCAL INFILE 'C:/Users/PC/Downloads/source_crm/sales_details.csv'
INTO TABLE crm_sales_dteails
